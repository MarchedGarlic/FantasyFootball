# Generated analysis output (every report/JSON file under here is regenerated fresh by
# `python main.py` on every Netlify build via netlify.toml's build command - it should never be
# committed. A stale or placeholder-contaminated commit here has previously ended up served
# straight to production; don't re-add exceptions for specific report files.)
fantasy_analysis_output/

